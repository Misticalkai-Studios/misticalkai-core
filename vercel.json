{
  "version": 2,
  "builds": [
    {
      "src": "v1/stats/youtube/youtube-subcount-logic.js",
      "use": "@vercel/node"
    },
    {
      "src": "v1/fan-submissions/user/user-logic.js",
      "use": "@vercel/node"
    },
    {
      "src": "v1/fan-submissions/admin/admin-logic.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/v1/user/view-form/submit-fan-mail",
      "dest": "v1/fan-submissions/user/user-logic.js"
    },
    {
      "src": "/v1/admin/view-form/fan-submissions",
      "dest": "v1/fan-submissions/admin/admin-logic.js"
    },
    {
      "src": "/v1/stats/youtube/sub-count",
      "dest": "v1/stats/youtube/youtube-subcount-logic.js"
    }
  ]
}